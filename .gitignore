# Dependencies
node_modules/
.npm-cache/

# Environment & secrets — never commit real credentials
.env
.env.local
.env.*.local

# Uploaded patient documents — private health data, never commit
server/uploads/*
!server/uploads/.gitkeep

# Logs — includes the npm run dev output (./server.log)
*.log
logs/

# QA artifacts (rendered screenshots and video frames from testing)
test/shots/
test/videoframes/

# OCR language data — restored by npm install via @tesseract.js-data/eng
eng.traineddata

# Personal project notes — not for public
/idea
/context of ARIA.txt

# Accidental nested server dir (path-bug artifact)
server/server/

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Editors & IDE
.vscode/
.idea/

# ZCode session data
.zcode/
aria-copilot-history.bundle

# Python (Copilot backend) — bytecode, caches, virtualenvs
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Copilot SPA build output — rebuilt with `npm run build:copilot`;
# the Docker build compiles its own copy inside the image
aria-recovery-copilot/frontend/dist/
Aria_document.docx