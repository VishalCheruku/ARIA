PORT=5000

# Local MongoDB by default. For the free MongoDB Atlas tier paste your
# connection string here, e.g. mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/ARIA_ai
MONGODB_URI=mongodb://127.0.0.1:27017/ARIA-AI_DB

# Authentication. Set a long random secret before using real accounts.
AUTH_TOKEN_SECRET=change-this-local-secret
AUTH_TOKEN_TTL_SECONDS=28800
# Registration is open by default; set to false to close sign-ups.
AUTH_ALLOW_REGISTRATION=true

# Twilio credentials. Leave blank to run in demo mode.
# HIGH and MEDIUM-risk reports get a personalized voice call + SMS;
# low risk gets SMS only. Call scripts read each patient's own
# name, diagnosis and medicine list from their report.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+15551234567

# Optional fallback phone for demo documents without a contact number.
DEMO_DEFAULT_PHONE=+919999999999
