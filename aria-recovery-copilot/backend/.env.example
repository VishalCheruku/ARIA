# ===== ARIA Recovery Copilot — backend environment (its own secrets) =====
# Never share this .env with the main ARIA backend. The ONE deliberate coupling
# point is COPILOT_SIGNING_SECRET, which must hold the same value as the main
# backend's COPILOT_SIGNING_SECRET (spec §8.5).

# --- GLM-5.3-flash via Z.ai ---
ZAI_API_KEY=your-zai-api-key
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_MODEL=glm-5.3-flash

# --- Embeddings ---
# zai   = Z.ai embeddings endpoint (production)
# local = sentence-transformers in-process (optional install)
# hash  = dependency-free lexical fallback (dev/test ONLY)
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIMENSIONS=1024
# LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- MongoDB (own database; can share the Atlas cluster, NEVER the main DB) ---
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net
MONGODB_DB=aria_copilot
ATLAS_VECTOR_INDEX=kb_vector_index

# --- Token coupling with the main backend (must match main backend value) ---
COPILOT_SIGNING_SECRET=change-me-shared-signing-secret
COPILOT_TOKEN_AUDIENCE=aria-copilot

# --- Main backend (the only outbound calls: context-summary read, alerts write) ---
MAIN_BACKEND_URL=http://localhost:5000

# --- Retrieval ---
RETRIEVAL_TOP_K=5
RETRIEVAL_THRESHOLD=0.72

# --- HTTP ---
CORS_ORIGINS=http://localhost:5173,http://localhost:5000
TRIAGE_STAGE2_ENABLED=true
LOG_LEVEL=INFO
