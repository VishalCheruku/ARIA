# Copilot frontend env (build-time, Vite)
# Leave VITE_API_BASE EMPTY for the Render single-service deploy — the FastAPI
# backend serves this SPA at /chat, so /api calls are same-origin.
# Only set it if you split the frontend onto its own host:
# VITE_API_BASE=https://aria-copilot.onrender.com
VITE_API_BASE=
# Emergency number shown on the escalation banner CTA.
VITE_EMERGENCY_NUMBER=108
